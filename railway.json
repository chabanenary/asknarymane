{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksConfigPath": "backend/nixpacks.toml"
  },
  "deploy": {
    "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
