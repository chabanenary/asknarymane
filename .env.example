# LLM Provider: "ollama" (local) or "groq" (cloud)
LLM_PROVIDER=ollama

# Embedding Provider: "ollama" (dev, needs Ollama) or "default" (prod, ChromaDB built-in)
EMBEDDING_PROVIDER=ollama

# ChromaDB Mode: "http" (dev, container) or "embedded" (prod, in-process)
CHROMA_MODE=http
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_DATA_PATH=./chroma_data

# Ollama (local dev)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2:1.5b

# Groq (cloud) - get your key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Backend API
API_HOST=0.0.0.0
API_PORT=8080

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
